{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],

  "permission": {
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "rm -r /*": "deny",
      "sudo *": "deny",
      "chmod 777 *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git push *": "ask",
      "npm install*": "ask",
      "npx prisma migrate*": "ask",
      "docker *": "ask"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*.lock": "deny",
      "package-lock.json": "deny"
    }
  },
  "plugin": [
    "opencode-pencil-sync",
    "@cortexkit/opencode-magic-context@latest"
  ],
  "compaction": {
    "auto": false,
    "prune": false
  },
  "provider": {
    "ollama": {
      "name": "Ollama Cloud",
      "options": {
        "baseURL": "https://ollama.com",
        "apiKey": "{env:OLLAMA_API_KEY}",
        "headers": {
          "Authorization": "Bearer {env:OLLAMA_API_KEY}"
        }
      },
      "models": {
        "ollama/kimi-k3": {
          "name": "Kimi K3"
        },
        "ollama/kimi-k2.7-code": {
          "name": "Kimi K2.7 Code"
        },
        "ollama/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "ollama/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "ollama/glm-5.2": {
          "name": "GLM 5.2"
        },
        "ollama/glm-5.1": {
          "name": "GLM 5.1"
        },
        "ollama/qwen3.5:122b": {
          "name": "Qwen 3.5 122B"
        },
        "ollama/qwen3.5": {
          "name": "Qwen 3.5"
        },
        "ollama/qwen3-coder-next": {
          "name": "Qwen3 Coder Next"
        },
        "ollama/gemma4": {
          "name": "Gemma 4"
        },
        "ollama/gemma4:31b": {
          "name": "Gemma 4 31B"
        },
        "ollama/nemotron-3-ultra": {
          "name": "Nemotron 3 Ultra"
        },
        "ollama/minimax-m3": {
          "name": "MiniMax M3"
        }
      }
    },
    "xiaomi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Xiaomi MiMo",
      "options": {
        "baseURL": "https://api.xiaomi.com/v1",
        "apiKey": "{env:XIAOMI_API_KEY}"
      },
      "models": {
        "xiaomi/mimo-v2-pro": {
          "name": "MiMo V2 Pro"
        },
        "xiaomi/mimo-v2": {
          "name": "MiMo V2"
        }
      }
    },
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://9router-pe7h.srv986324.hstgr.cloud/v1",
        "apiKey": "{env:NINEROUTER_API_KEY}"
      },
      "models": {
        "bulk": {
          "name": "9R Bulk",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        },
        "creative": {
